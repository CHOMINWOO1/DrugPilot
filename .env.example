# Public offline fixture demo. Explicitly configure live mode before real research.
DRUGPILOT_MODE=mock
DRUGPILOT_BUILD_VARIANT=public-research-demo
DRUGPILOT_AUTO_ACTIVATE_OPENAI=false
DRUGPILOT_OPENAI_MA3_REVIEWER_ENABLED=true
# LIVE only: source-bound interpretation + blinded verifier before claim assignment.
# Two metered calls per target with eligible excerpts; never bypasses primary gates.
DRUGPILOT_MA1_SEMANTIC_INTERPRETATION_ENABLED=true
DRUGPILOT_DATABASE_PATH=data/drugpilot.sqlite3
DRUGPILOT_MOCK_STEP_DELAY_MS=250
# Run-admission limits apply independently of optional LAN authentication.
# Live POST requests additionally require an Idempotency-Key header.
DRUGPILOT_BETA_MAX_ACTIVE_LIVE_RUNS=1
DRUGPILOT_BETA_MAX_NEW_RUNS_PER_HOUR=3
DRUGPILOT_BETA_LIVE_LEASE_TTL_SECONDS=900
DRUGPILOT_BETA_LIVE_LEASE_HEARTBEAT_SECONDS=30
# MA2 is selected independently of the LLM. Live mode never falls back to
# fixture candidates or computed values when a source/tool is unavailable.
DRUGPILOT_MA2_BACKEND_MODE=fixture
DRUGPILOT_MA2_LIVE_SCIENTIFIC_TOOLS_ENABLED=false
DRUGPILOT_MA2_LIVE_ALLOW_EXPERIMENTAL_DOCKING_PROFILES=false
# Independent ChEMBL budgets for MA2. These are intentionally not tied to
# the shorter MA1 public-evidence timeout. Retries are bounded and read-only;
# a final timeout remains an explicit unavailable result with no fixture fill.
DRUGPILOT_MA2_CHEMBL_TIMEOUT_SECONDS=30
DRUGPILOT_MA2_CHEMBL_OPERATION_TIMEOUT_SECONDS=120
DRUGPILOT_MA2_CHEMBL_MAX_ATTEMPTS=2
DRUGPILOT_MA2_CHEMBL_RETRY_BACKOFF_SECONDS=0.25
# Evaluate every G0-approved, identity-resolved target and retain per-target
# status/reason records.  Keep false only for legacy single-target demos.
DRUGPILOT_MA2_PORTFOLIO_ENABLED=true

# Paste secrets only in the local .env file, never in the browser or source code.
OPENAI_API_KEY=
# Optional independent G0/G1 reviewer. Deterministic MA3 remains active without it.
ANTHROPIC_API_KEY=
DRUGPILOT_TERRA_MODEL=gpt-5.6-terra
DRUGPILOT_SOL_MODEL=gpt-5.6-sol
DRUGPILOT_LUNA_MODEL=gpt-5.6-luna
DRUGPILOT_REVIEWER_MODEL=claude-opus-4-1

# Read-only public evidence/enrichment APIs need no LLM key. Disease resolution
# fails closed when unavailable. Research execution does not substitute
# fixture evidence, candidates, or computed values.
DRUGPILOT_PUBLIC_EVIDENCE_ENABLED=false
DRUGPILOT_PUBLIC_EVIDENCE_TIMEOUT_SECONDS=5
# Comprehensive research expands bounded evidence retrieval independently of
# LLM activation. Source allow-lists, applicability checks, provenance and
# fail-closed/no-fixture rules still apply. Use focused for the former short
# interactive profile (2 records/source, 1 target/track, 8 context calls).
DRUGPILOT_EVIDENCE_RESEARCH_DEPTH=comprehensive
DRUGPILOT_PUBLIC_EVIDENCE_MAX_RECORDS_PER_SOURCE=8
DRUGPILOT_PUBLIC_EVIDENCE_MAX_SOURCE_CALLS_PER_TARGET=5
DRUGPILOT_PUBLIC_EVIDENCE_MAX_ELAPSED_SECONDS_PER_TARGET=60
DRUGPILOT_PUBLIC_EVIDENCE_MAX_ATTEMPTS=2
DRUGPILOT_PUBLIC_EVIDENCE_RETRY_BACKOFF_SECONDS=0.2
# Optional, comprehensive-only Europe PMC OA JATS escalation. It runs only
# when the existing abstract evidence is insufficient, follows references
# one hop (never forward citations), and never stores raw XML or full text.
DRUGPILOT_EPMC_OA_FULLTEXT_ONE_HOP_V1=false
DRUGPILOT_PUBLIC_CANDIDATE_ENRICHMENT_ENABLED=false
DRUGPILOT_PUBLIC_CANDIDATE_ENRICHMENT_PER_ROUTE=5
DRUGPILOT_DYNAMIC_TARGET_DISCOVERY_ENABLED=false
DRUGPILOT_DYNAMIC_TARGET_MAX_CANDIDATES=8
# Additional evidence-only retries per MA1 rework, never deducted from the
# fresh target window. Set 0 to disable; keep small to bound public API cost.
DRUGPILOT_MA1_SUPPLEMENTARY_EVIDENCE_RETRY_BUDGET=1
DRUGPILOT_TARGET_DISCOVERY_PUBMED_MAX_RECORDS=40
DRUGPILOT_TARGET_DISCOVERY_MAX_PUBMED_SUPPLEMENTS=6
DRUGPILOT_TARGET_DISCOVERY_TARGET_LOOKUP_LIMIT=8
DRUGPILOT_DYNAMIC_TARGET_FALLBACK_ENABLED=true
# Deliberate opt-in for fixture-only demonstrations. Keep false for research runs.
DRUGPILOT_DEMO_FIXTURE_FALLBACK_ENABLED=true
DRUGPILOT_TARGET_IDENTITY_RESOLUTION_ENABLED=true
DRUGPILOT_DYNAMIC_CONTEXT_ENABLED=false
DRUGPILOT_DYNAMIC_CONTEXT_TARGETS_PER_TRACK=2
DRUGPILOT_DYNAMIC_CONTEXT_MAX_CALLS=36
DRUGPILOT_DYNAMIC_CONTEXT_MAX_SECONDS=90
DRUGPILOT_DYNAMIC_CONTEXT_LIMIT_PER_SOURCE=5
# 0 disables explicit-only Pharos routing; default interactive runs still make 0 Pharos calls.
DRUGPILOT_PHAROS_ON_DEMAND_TARGETS_PER_TRACK=1

# Optional source-specific settings. Public APIs work without these values.
NCBI_API_KEY=
DRUGPILOT_NCBI_EMAIL=
DRUGPILOT_NCBI_TOOL=DrugPilot
# BioGRID: free per-application key; selected for Tbio/network context.
BIOGRID_ACCESS_KEY=
# DrugBank: licensed API key; selected for repurposing identity/regulatory checks.
DRUGBANK_API_KEY=
DRUGPILOT_DRUGCENTRAL_DATASET_PATH=
DRUGPILOT_DRUGCENTRAL_DATASET_VERSION=
# Retained only for an optional bulk ARCHS4 snapshot. Interactive lookup uses
# the keyless public SigPy endpoint and does not require this path.
DRUGPILOT_ARCHS4_DATASET_PATH=
# Base URL of the operator-supplied Linux/macOS CELLxGENE Census sidecar.
DRUGPILOT_CELLXGENE_SERVICE_URL=
# Enables the metered Google Patents BigQuery adapter. Application Default
# Credentials must also be configured (for example with gcloud auth application-default login).
DRUGPILOT_GOOGLE_CLOUD_PROJECT=

# Per-run guardrails from the planning report.
DRUGPILOT_MAX_RUN_TOKENS=1000000
DRUGPILOT_HARD_MAX_RUN_TOKENS=5000000
DRUGPILOT_MAX_LLM_CALLS=72
DRUGPILOT_MAX_SINGLE_INPUT_TOKENS=250000
DRUGPILOT_MAX_RUN_COST_USD=46.67
DRUGPILOT_CANDIDATES_PER_ROUTE=5
DRUGPILOT_MAX_MA1_ITERATIONS=3
DRUGPILOT_MAX_REWORK_LOOPS=2

# Optional public API/MCP and local scientific-tool configuration. Set these
# only when MA2 live scientific tools are explicitly enabled.
DRUGPILOT_DGIDB_MCP_URL=
DRUGPILOT_VINA_BINARY=
DRUGPILOT_DOCKING_PROFILE_REGISTRY_PATH=
DRUGPILOT_ADMET_PYTHON_EXECUTABLE=

# Offline receptor-profile builder. It remains inactive unless explicitly
# enabled. Prefer a dedicated Python interpreter containing PDBFixer/OpenMM,
# Meeko and PoseBusters. On Windows, invoke P2Rank through the configured Java
# executable and official P2Rank JAR/classpath; .bat/.cmd wrappers are not
# executed by the service.
DRUGPILOT_RECEPTOR_BUILDER_ENABLED=false
DRUGPILOT_RECEPTOR_PYTHON_EXECUTABLE=
# ASCII-safe RDKit package root containing Data/BaseFeatures.fdef. This avoids
# native RDKit path failures when the workspace path contains non-ASCII text.
DRUGPILOT_RECEPTOR_RDKIT_ROOT=
# OpenMM plugin directory used by the same isolated receptor worker.
DRUGPILOT_RECEPTOR_OPENMM_PLUGIN_DIR=
DRUGPILOT_RECEPTOR_MEEKO_RECEPTOR_EXECUTABLE=
DRUGPILOT_RECEPTOR_MEEKO_LIGAND_EXECUTABLE=
DRUGPILOT_RECEPTOR_P2RANK_EXECUTABLE=
DRUGPILOT_RECEPTOR_P2RANK_JAR_PATH=
DRUGPILOT_RECEPTOR_JAVA_EXECUTABLE=
DRUGPILOT_RECEPTOR_PROBE_TIMEOUT_SECONDS=10
